{
  "name": "studybuddy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"npm:dev:server\" \"npm:dev:client\"",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173 --strictPort",
    "test": "tsx --test src/model.test.ts server/*.test.ts",
    "test:e2e": "playwright test",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "start": "tsx server/index.ts",
    "db:init": "tsx server/init.ts",
    "desktop:prepare": "npm run build && node desktop/build.mjs",
    "desktop:dev": "npm run desktop:prepare && npm --prefix desktop start",
    "desktop:win": "npm run desktop:prepare && npm --prefix desktop run dist:win"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "lucide-react": "^0.468.0",
    "marked": "^18.1.1",
    "multer": "^2.5.0",
    "openai": "^7.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
